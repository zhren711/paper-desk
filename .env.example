# 复制为 .env 或在托管平台的“环境变量”里逐项填写

# 必填：Claude API key（只保存在服务器上，浏览器看不到）
ANTHROPIC_API_KEY=

# 强烈建议：访问码。设置后，打开网站需要先输入它，防止陌生人消耗你的 API 额度
ACCESS_CODE=

# 可选：使用 PostgreSQL（例如 Neon）。不填则使用本地 SQLite 文件
DATABASE_URL=
SQLITE_PATH=./data/paper-desk.db

# 可选：模型。润色与翻译默认 claude-sonnet-5-5；标题翻译默认 claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# 可选：每个 IP 每小时最多调用多少次润色/翻译，以及最多新建多少篇论文
AI_REQUESTS_PER_HOUR=200
NEW_PAPERS_PER_HOUR=30

# 可选：前面有几层反向代理（Render、Nginx、Caddy 等为 1；直接对外暴露端口时设为 0）
TRUST_PROXY=1

# 可选：端口（托管平台通常会自动设置）
PORT=3000

# 仅用于本地调试界面：设为 1 时不调用 Claude，返回模拟结果
AI_MOCK=0
